{
  "name": "the-blackout",
  "version": "1.0.0",
  "private": true,
  "description": "The Blackout: a three-stage, seven-minute cybersecurity escape room",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:frontend": "node scripts/buildFrontend.js",
    "ai:check": "node backend/checkAi.js",
    "test": "node --test test/backend.test.js test/frontend.test.js test/frontend-ai.test.js test/deployment.test.js",
    "check:syntax": "node scripts/checkSyntax.js",
    "prestart": "npm run check:syntax"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22"
  }
}
